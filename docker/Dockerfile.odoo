FROM python:3.11-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev && rm -rf /var/lib/apt/lists/*
COPY requirements.txt* ./
RUN pip wheel --no-cache-dir --wheel-dir /wheels psycopg2-binary

FROM python:3.11-slim
RUN useradd -m -u 10001 erpuser
WORKDIR /opt/erp
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels
USER erpuser
EXPOSE 8069
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8069/web/health')"
CMD ["python", "-m", "http.server", "8069"]
